# Seeed XIAO ESP32-S3 / ESP32-S3 Sense profile.
# ESP32-S3R8: 8 MB flash + 8 MB OCTAL PSRAM, native USB only (no UART bridge chip),
# single Type-C port on GPIO19/20, U.FL external antenna, LiPo charging on board.
# For the "XIAO ESP32-S3 Plus" (16 MB flash) skip this profile and use the default.

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# USB: the Type-C port is the native USB peripheral, so the console must come from
# USB Serial/JTAG rather than a UART bridge, and phase 2 (USB-NCM gadget) uses the same port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
