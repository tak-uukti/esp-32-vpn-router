# Copy to sdkconfig.credentials and fill in. Never commit the filled file.
CONFIG_GADGET_WIFI_SSID="your-uplink-ssid"
CONFIG_GADGET_WIFI_PASSWORD="your-uplink-password"
CONFIG_GADGET_TS_AUTH_KEY="tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxx"
CONFIG_GADGET_DEVICE_NAME="tailnet-gadget"
CONFIG_GADGET_AP_SSID="tailnet-gadget"
CONFIG_GADGET_AP_PASSWORD="pick-something-real"
